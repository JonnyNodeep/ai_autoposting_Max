# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_ADMIN_API_KEY=sk-admin-...

# MAX Bot
MAXBOT_TOKEN=...

# Telegram Bot (optional dual-publish to Telegram channels)
TELEGRAM_TOKEN=

# App
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# Webhook (production URL for MAX to send updates to)
APP_WEBHOOK_URL=https://your-domain.com/webhook/max
APP_WEBHOOK_SECRET=generate-strong-random-secret-here

# API auth token (required for API access)
APP_API_TOKEN=generate-strong-random-token-here

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=maxstudio
POSTGRES_PASSWORD=maxstudio
POSTGRES_DB=maxstudio

# Redis
REDIS_URL=redis://redis:6379/0

# OpenAI models
OPENAI_TEXT_MODEL=gpt-5.5-mini
OPENAI_IMAGE_MODEL=imagen-1.5
# low | medium | high (low — only for cost/quality testing)
OPENAI_IMAGE_QUALITY=medium
OPENAI_SEARCH_MODEL=gpt-4o-mini-search-preview
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Yandex SpeechKit (TTS; optional proxy for non-RU servers)
YANDEX_FOLDER_ID=
YANDEX_SPEECHKIT_API_KEY=
YANDEX_TTS_PROXY=

# RSS / site fetch (optional HTTP proxy for RU sites from non-RU servers)
RSS_HTTP_PROXY=

# ЮKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# VidGo (video generation)
VIDGO_API_KEY=
# Public HTTPS URL VidGo will POST to, e.g. https://your-domain.com/webhook/vidgo?token=...
VIDGO_CALLBACK_URL=
# Shared token appended as ?token=... (required if callback URL is set)
VIDGO_WEBHOOK_TOKEN=

# Admin
ADMIN_MAX_USER_ID=
ADMIN_API_TOKEN=change-me
ADMIN_WEB_PASSWORD=
# Optional; defaults to ADMIN_WEB_PASSWORD / ADMIN_API_TOKEN for cookie signing
ADMIN_SESSION_SECRET=
# Premium features (max_user_id comma-separated; empty = nobody)
FEATURE_RSS_WHITELIST=
FEATURE_VIDEO_WHITELIST=
FEATURE_AUDIO_WHITELIST=
